<Window x:Class="WinUI3Clipper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Clipper">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0"
                PlaceholderText="Type to search..." FontSize="14"
                TextChanged="OnSearchTextChanged"/>
            <Button x:Name="CloseButton" Grid.Column="1"
                Content="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                Width="36" Height="36" Margin="8,0,0,0" Click="OnCloseClick"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="1"
            Text="Loading..." FontSize="12" Margin="12,0,12,6"/>
        <ListView x:Name="ClipList" Grid.Row="2"
            ItemsSource="{x:Bind Items}"
            SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
            SelectionMode="Single" IsRightTapEnabled="True"
            RightTapped="OnItemRightTapped" DoubleTapped="OnItemDoubleTapped"
            KeyDown="OnListKeyDown" Background="Transparent" BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ClipboardItem">
                    <Grid Height="32" Padding="12,4" Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="11"
                            Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayContent, Mode=OneWay}"
                            FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedTimestamp, Mode=OneWay}"
                            FontSize="11" Margin="12,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="BottomStatus" Text="0 items" FontSize="11"/>
        </Border>
    </Grid>
</Window>
