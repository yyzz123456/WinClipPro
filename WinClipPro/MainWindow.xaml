<Window x:Class="WinClipPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:WinClipPro"
        xmlns:models="clr-namespace:WinClipPro.Models"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="WinClip Pro"
        Height="600" Width="400"
        MinHeight="300" MinWidth="280"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- System button style -->
        <Style x:Key="SystemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Acrylic backdrop surface -->
        <Border x:Name="AcrylicBorder" CornerRadius="8" ClipToBounds="True">
            <Border.Background>
                <SolidColorBrush Color="#00000000" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="32"
                        Background="#20000000" MouseLeftButtonDown="OnTitleBarDrag">
                    <Grid>
                        <TextBlock Text="WinClip Pro" Foreground="#FFFFFF"
                                   FontSize="12" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource SystemButtonStyle}"
                                    Width="32" Height="32" Click="OnToggleTopmost"
                                    ToolTip="Toggle always on top" />
                            <Button Content="&#xE106;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource SystemButtonStyle}"
                                    Width="32" Height="32" Click="OnHideWindow"
                                    ToolTip="Hide (Ctrl+Shift+V to show)" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main content -->
                <Border Grid.Row="1" Margin="4,0,4,0" Background="#20000000" CornerRadius="6">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search box with placeholder -->
                        <Border Grid.Row="0" Margin="0,4,0,8" Height="32"
                                Background="#30FFFFFF" CornerRadius="4"
                                BorderBrush="#20FFFFFF" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#80FFFFFF" FontSize="14"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock x:Name="PlaceholderText"
                                           Text="Search clipboard..."
                                           Foreground="#60FFFFFF" FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="28,0,0,0"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFFFF" CaretBrush="#FFFFFFFF"
                                         FontSize="13" Padding="28,0,8,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnSearchTextChanged"
                                         GotFocus="OnSearchGotFocus"
                                         LostFocus="OnSearchLostFocus" />
                            </Grid>
                        </Border>

                        <!-- Clipboard list -->
                        <ListBox x:Name="ClipboardList" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#FFFFFFFF" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionChanged="OnItemSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClipboardItem}">
                                    <Border Background="#18FFFFFF" CornerRadius="4"
                                            Margin="0,2" Padding="8,6" Cursor="Hand">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy" Click="OnCopyItem"
                                                          DataContext="{Binding}" />
                                                <MenuItem Header="Pin / Unpin" Click="OnTogglePin"
                                                          DataContext="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Delete" Click="OnDeleteItem"
                                                          DataContext="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Summary}"
                                                       Foreground="#E0FFFFFF"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                        Margin="0,2,0,0">
                                                <TextBlock Text="{Binding DateTime,
                                                    StringFormat='{}{0:MM-dd HH:mm}'}"
                                                           Foreground="#60FFFFFF" FontSize="10" />
                                                <TextBlock Text="  &#xE718;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="#80FFD700" FontSize="10"
                                                           Visibility="{Binding IsPinned,
                                                               Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Status bar -->
                <Border Grid.Row="2" Margin="4,4,4,8" Padding="8,4"
                        Background="#18000000" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" Text="Ready"
                                   Foreground="#80FFFFFF" FontSize="11" />
                        <TextBlock x:Name="ItemCount" Text=""
                                   Foreground="#60FFFFFF" FontSize="11" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
